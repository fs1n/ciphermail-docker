# Kopieren nach .env (wird nicht committet)

# Release-Tag von https://gitlab.com/ciphermail/ciphermail-community-gateway
CM_REF=6.5.0

# Datenbank (Compose legt sie mit diesem Passwort an)
DB_PASSWORD=bitte-aendern

# Verschlüsselt die privaten S/MIME-Schlüssel in der Datenbank. Pflicht, mind. 16 Zeichen,
# z.B. openssl rand -base64 32. Gut aufbewahren (gehört zu jedem DB-Backup) und NIE ändern:
# mit einem anderen Passwort sind die gespeicherten Schlüssel unlesbar.
KEYSTORE_PASSWORD=

# Arbeitsspeicher des Containers (Backend 40 %, Portal 20 %)
MEMORY_LIMIT=2g

# Erster Admin für die Admin-UI (nur beim ersten Start). Mindestens 12 Zeichen,
# keine 5 gleichen Zeichen oder Tastaturfolgen, nicht den Kontonamen.
ADMIN_PASSWORD=

# Hostname des Mailservers (HELO/Banner); nur beim ersten Start in main.cf übernommen
MYHOSTNAME=mail.example.com

# Port 25 und 443 (Portal) standardmässig nur lokal; 0.0.0.0 für alle Schnittstellen
SMTP_BIND=127.0.0.1
PORTAL_BIND=127.0.0.1

# Hinter einem Reverse-Proxy: dessen Adresse(n) bzw. Netz, und die Ports, unter denen
# Admin-UI und Portal öffentlich erreichbar sind
TRUSTED_PROXIES=
ADMIN_PUBLIC_PORT=8443
PORTAL_PUBLIC_PORT=443
