# Kopieren nach .env (wird nicht committet)

# Release-Tag von https://gitlab.com/ciphermail/ciphermail-community-gateway
CM_REF=6.5.0

# Datenbank (Compose legt sie mit diesem Passwort an)
DB_PASSWORD=bitte-aendern

# Erster Admin für die Admin-UI (nur beim ersten Start). Mindestens 12 Zeichen,
# keine 5 gleichen Zeichen oder Tastaturfolgen, nicht den Kontonamen.
ADMIN_PASSWORD=

# Hostname des Mailservers (HELO/Banner); nur beim ersten Start in main.cf übernommen
MYHOSTNAME=mail.example.com

# Port 25 und 443 (Portal) standardmässig nur lokal; 0.0.0.0 für alle Schnittstellen
SMTP_BIND=127.0.0.1
PORTAL_BIND=127.0.0.1
