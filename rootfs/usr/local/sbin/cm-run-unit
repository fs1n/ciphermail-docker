#!/bin/bash
#
# Startet einen Dienst aus einer systemd-Unit der CipherMail-Pakete ohne systemd.
# Die Unit wird zur Laufzeit gelesen, damit neue Paketversionen ohne Anpassung laufen.
#
# Unterstützt: User, Group, WorkingDirectory, Environment, EnvironmentFile, ExecStartPre,
# ExecStart, RuntimeDirectory, LogsDirectory, StateDirectory, SyslogIdentifier.
# Ignoriert: PrivateTmp, Restart (macht supervisord) und alles andere.
#
# Aufruf: cm-run-unit <unit-name-ohne-.service>

set -euo pipefail

unit=${1:?Aufruf: cm-run-unit <unit>}
file=
for d in /usr/lib/systemd/system /lib/systemd/system /etc/systemd/system; do
    [[ -f $d/$unit.service ]] && file=$d/$unit.service
done
[[ -n $file ]] || { echo "cm-run-unit: Unit $unit nicht gefunden" >&2; exit 1; }

# Abschnitt [Service] lesen, Fortsetzungszeilen ("\" am Zeilenende) zusammenfügen
mapfile -t lines < <(
    sed -e ':a' -e '/\\$/{N;s/\\\n/ /;ba}' "$file" \
    | awk '/^\[/ { s = ($0 == "[Service]"); next } s && /^[A-Za-z]+=/'
)

user=root group= workdir=/ start= ident=$unit
pre=() envfiles=() envassign=() rundirs=() logdirs=() statedirs=()
for l in "${lines[@]}"; do
    key=${l%%=*} val=${l#*=}
    case $key in
        User) user=$val ;;
        Group) group=$val ;;
        WorkingDirectory) workdir=${val#-} ;;
        ExecStartPre) pre+=("$val") ;;
        ExecStart) start=$val ;;
        EnvironmentFile) envfiles+=("$val") ;;
        Environment) envassign+=("$val") ;;
        SyslogIdentifier) ident=$val ;;
        RuntimeDirectory) read -ra a <<< "$val"; rundirs+=("${a[@]}") ;;
        LogsDirectory) read -ra a <<< "$val"; logdirs+=("${a[@]}") ;;
        StateDirectory) read -ra a <<< "$val"; statedirs+=("${a[@]}") ;;
    esac
done
[[ -n $start ]] || { echo "cm-run-unit: $file hat kein ExecStart" >&2; exit 1; }
group=${group:-$(id -gn "$user")}
home=$(getent passwd "$user" | cut -d: -f6)

# Ab hier geht alles (auch die Ausgabe des Dienstes) über cm-journal: stdout + Log für das Admin-UI
exec > >(exec /usr/local/sbin/cm-journal "$ident") 2>&1

for d in "${rundirs[@]}"; do install -d -o "$user" -g "$group" -m 0755 "/run/$d"; done
for d in "${logdirs[@]}"; do install -d -o "$user" -g "$group" -m 0755 "/var/log/$d"; done
for d in "${statedirs[@]}"; do install -d -o "$user" -g "$group" -m 0755 "/var/lib/$d"; done

as_user() {
    setpriv --reuid="$user" --regid="$group" --init-groups -- "$@"
}

# Präfixe von systemd: "+" und "!" = mit vollen Rechten, "-" = Fehler ignorieren, "@" und ":" ignoriert.
# Fehler in ExecStartPre brechen hier nicht ab (z.B. setfacl auf /run/systemd/ask-password,
# das es ohne systemd nicht gibt), sie werden nur gemeldet.
for cmd in "${pre[@]}"; do
    flags=
    while [[ $cmd == [-@:+!]* ]]; do flags+=${cmd:0:1}; cmd=${cmd:1}; done
    if [[ $flags == *[+!]* || $user == root ]]; then
        bash -c "$cmd" || echo "cm-run-unit: ExecStartPre fehlgeschlagen (ignoriert): $cmd"
    else
        as_user bash -c "$cmd" || echo "cm-run-unit: ExecStartPre fehlgeschlagen (ignoriert): $cmd"
    fi
done
while [[ $start == [-@:+!]* ]]; do start=${start:1}; done

# Saubere Umgebung wie bei systemd: keine Container-Variablen (Passwörter!) an den Dienst
env=(
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    "LANG=${LANG:-C.UTF-8}"
    "HOME=${home:-/}" "USER=$user" "LOGNAME=$user"
)
[[ -n ${TZ:-} ]] && env+=("TZ=$TZ")
# Erlaubt z.B. Speicher- oder Proxy-Einstellungen für die JVM von aussen
[[ -n ${JAVA_TOOL_OPTIONS:-} ]] && env+=("JAVA_TOOL_OPTIONS=$JAVA_TOOL_OPTIONS")

for a in "${envassign[@]}"; do
    eval "words=($a)"
    env+=("${words[@]}")
done

for f in "${envfiles[@]}"; do
    optional=false
    [[ $f == -* ]] && { optional=true; f=${f#-}; }
    if [[ ! -r $f ]]; then
        $optional || { echo "cm-run-unit: EnvironmentFile $f fehlt" >&2; exit 1; }
        continue
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
        k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
        if [[ $v =~ ^\"(.*)\"$ || $v =~ ^\'(.*)\'$ ]]; then v=${BASH_REMATCH[1]}; fi
        env+=("$k=$v")
    done < "$f"
done

cd "$workdir"
echo "cm-run-unit: starte $unit als $user"
exec env -i "${env[@]}" setpriv --reuid="$user" --regid="$group" --init-groups -- /bin/bash -c "exec $start"
