#!/bin/bash
#
# Gesund, wenn alle Dienste laufen, der Postfix-Master lebt und die REST-API des Backends (8081)
# Verbindungen annimmt. Port 25 wird bewusst nicht geprüft (jede Prüfung landet im Mail-Log).

set -u

for p in postfix ciphermail-backend ciphermail-portal-backend apache2; do
    supervisorctl -c /etc/supervisor/supervisord.conf status "$p" 2>/dev/null | grep -q ' RUNNING ' \
        || { echo "$p läuft nicht"; exit 1; }
done

/usr/sbin/postfix status >/dev/null 2>&1 || { echo "Postfix-Master läuft nicht"; exit 1; }

for port in 8081; do
    timeout 3 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" 2>/dev/null \
        || { echo "Port $port antwortet nicht"; exit 1; }
done
exit 0
