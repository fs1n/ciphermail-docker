#!/bin/bash
#
# Minimales systemctl (installiert als /usr/bin/systemctl, im Image gibt es kein systemd).
#
# Nur noch nötig für zwei Skripte der Pakete, die systemctl fest aufrufen und sich nicht
# per Konfiguration umstellen lassen:
#   cm-system.sh       systemctl status <dienst>   (läuft der Dienst?)
#   cm-postfix-map.sh  systemctl reload postfix    (nach Änderung einer Map)
# sowie für "systemctl daemon-reload" in den postinst-Skripten beim Image-Build.
# Postfix-Start/-Stop des Backends geht über cm-postfix-control, nicht hierüber.

action=
units=()
for a in "$@"; do
    case $a in
        -*) ;;
        *) if [[ -z $action ]]; then action=$a; else units+=("$a"); fi ;;
    esac
done

# postfix@-.service, postfix.service -> postfix
name() { local u=${1%.service}; echo "${u%%@*}"; }

running() {
    supervisorctl -c /etc/supervisor/supervisord.conf status "$1" 2>/dev/null | grep -q ' RUNNING '
}

rc=0
case $action in
    status|is-active)
        for u in "${units[@]}"; do
            n=$(name "$u")
            if running "$n"; then
                [[ $action == is-active ]] && echo active || echo "$n: running"
            else
                [[ $action == is-active ]] && echo inactive || echo "$n: not running"
                rc=3
            fi
        done
        ;;
    reload)
        for u in "${units[@]}"; do
            case $(name "$u") in
                postfix) /usr/sbin/postfix reload || rc=1 ;;
                *) echo "systemctl reload $u: im Container nicht unterstützt" >&2; rc=1 ;;
            esac
        done
        ;;
    daemon-reload|enable|disable|mask|unmask|preset)
        ;;
    *)
        echo "systemctl $action: im Container nicht unterstützt (kein systemd)" >&2
        rc=1
        ;;
esac
exit $rc
